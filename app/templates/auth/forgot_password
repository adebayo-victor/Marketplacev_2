{% extends 'base.html' %}

{% block title %}Request Prepared // Marketplace{% endblock %}

{% block content %}
<div class="min-h-[85vh] flex items-center justify-center p-4 py-12 text-center">
    <div class="max-w-md w-full bg-white p-10 shadow-2xl border-t-[5px] border-[#16a34a]">
        
        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">
            ✓
        </div>

        <h1 class="font-ui text-2xl font-bold text-dark-oak mb-2">Request Ready!</h1>
        <p class="font-serif italic text-xs text-stone-500 mb-6">
            Account to verify: <strong>{{ account }}</strong>
        </p>

        <div class="p-5 bg-stone-50 border border-stone-200 rounded-xl mb-6 text-left space-y-2">
            <span class="font-ui text-[10px] font-bold uppercase tracking-wider text-dark-oak block">Expected Resolution Time</span>
            <p class="font-serif text-xs text-stone-600 leading-relaxed m-0">
                Tap the button below to send your pre-filled reset message to our admin WhatsApp (<strong>08136390030</strong>).
            </p>
            <p class="font-ui text-[11px] text-clay font-bold m-0 pt-1">
                ⏱️ Expect your temporary credentials within 24 hours.
            </p>
        </div>

        <a href="{{ whatsapp_url }}" target="_blank" 
           class="w-full bg-[#16a34a] hover:bg-[#15803d] text-white font-ui font-bold py-4 px-4 rounded-xl shadow-lg block text-xs uppercase tracking-wider transition">
            OPEN WHATSAPP & SEND REQUEST &rarr;
        </a>

        <div class="mt-6 pt-4 border-t border-stone-100">
            <a href="{{ url_for('auth.login') }}" class="font-ui text-xs font-semibold text-stone-400 hover:text-dark-oak">&larr; Return to Login</a>
        </div>
    </div>
</div>
{% endblock %}
